# ====================================
# AI Daily Push 环境变量配置示例
# ====================================
# 复制此文件为 .env 并填入实际值
#
# 使用方法：
# 1. cp .env.example .env
# 2. 编辑 .env 填入真实的密钥和配置
# 3. .env 文件已在 .gitignore 中，不会被提交到 git
#
# Windows 用户提示：
# - 不要用记事本编辑，使用 VSCode 或其他代码编辑器
# - 保存时选择 UTF-8 编码
# ====================================

# ============================================================
# 1. 核心推送配置（至少配置一种）
# ============================================================

# --- 企业微信群机器人（推荐） ---
# 获取方式：企业微信群 -> 群设置 -> 群机器人 -> 添加机器人 -> 复制webhook
WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY_HERE

# --- 企业微信应用消息（高级） ---
# 获取方式：企业微信管理后台 -> 应用管理 -> 自建应用
WECOM_CORPID=ww1234567890abcdef
WECOM_CORPSECRET=YOUR_SECRET_HERE
WECOM_AGENTID=1000001
WECOM_TOUSER=@all

# --- 飞书群机器人 ---
# 获取方式：飞书群 -> 设置 -> 群机器人 -> 添加机器人 -> 复制webhook
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/YOUR_TOKEN_HERE

# --- 钉钉群机器人 ---
# 获取方式：钉钉群 -> 群设置 -> 智能群助手 -> 添加机器人 -> 自定义
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN_HERE
DINGTALK_SECRET=YOUR_SECRET_HERE

# --- PushPlus（推送到个人微信） ---
# 获取方式：http://www.pushplus.plus/ 注册账号获取token
PUSHPLUS_TOKEN=YOUR_PUSHPLUS_TOKEN_HERE
PUSHPLUS_TOPIC=

# ============================================================
# 2. 监控告警配置（推荐配置）
# ============================================================

# --- 告警推送渠道（独立于日报推送） ---
# 注意：告警推送建议使用独立的webhook，避免干扰日常推送

# 企业微信告警webhook（推荐单独创建一个告警专用机器人）
ALERT_WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_ALERT_KEY_HERE

# 钉钉告警webhook
ALERT_DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=YOUR_ALERT_TOKEN_HERE
ALERT_DINGTALK_SECRET=YOUR_ALERT_SECRET_HERE

# 飞书告警webhook
ALERT_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/YOUR_ALERT_TOKEN_HERE

# 自定义告警webhook（通用HTTP POST接口）
ALERT_WEBHOOK=https://your-custom-webhook.com/alert

# 邮件告警（可选）
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USERNAME=your-email@gmail.com
ALERT_EMAIL_PASSWORD=your-app-password
ALERT_EMAIL_FROM=your-email@gmail.com
ALERT_EMAIL_TO=admin@example.com,ops@example.com

# ============================================================
# 3. LLM API 配置（必填）
# ============================================================

# --- OpenAI API ---
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# --- Claude API（备选） ---
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_API_KEY_HERE
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- 通义千问 API（备选） ---
DASHSCOPE_API_KEY=sk-YOUR_QWEN_API_KEY_HERE

# ============================================================
# 4. GitHub 配置
# ============================================================

# GitHub Personal Access Token（用于监控GitHub Actions）
# 获取方式：GitHub Settings -> Developer settings -> Personal access tokens -> Generate new token
# 需要权限：repo (Full control of private repositories)
GITHUB_TOKEN=ghp_YOUR_GITHUB_TOKEN_HERE
GITHUB_REPO=yunix-intel/ai-daily-push

# ============================================================
# 5. 微信公众号配置（可选）
# ============================================================

# 微信公众号（用于自动发布文章）
WECHAT_APPID=wx1234567890abcdef
WECHAT_SECRET=YOUR_WECHAT_SECRET_HERE

# ============================================================
# 6. 应用配置
# ============================================================

# 运行环境
APP_ENV=production  # dev, staging, production

# 日志级别
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# 日志目录
LOG_DIR=logs

# 缓存目录
CACHE_DIR=.cache

# ============================================================
# 7. 监控配置
# ============================================================

# 是否启用监控
MONITOR_ENABLED=true

# 指标导出路径
METRICS_EXPORT_PATH=metrics.json

# 健康检查间隔（秒）
HEALTH_CHECK_INTERVAL=300

# ============================================================
# 8. 数据源配置
# ============================================================

# API请求超时（秒）
FETCH_TIMEOUT=30

# 最大重试次数
MAX_RETRIES=3

# 重试延迟（秒）
RETRY_DELAY=5

# ============================================================
# 9. GitHub Actions 专用配置
# ============================================================
# 注意：在GitHub Actions中使用Secrets配置，不要直接在workflow文件中暴露

# 在 GitHub Settings -> Secrets and variables -> Actions 中配置：
# - OPENAI_API_KEY
# - WECOM_WEBHOOK 或 FEISHU_WEBHOOK
# - PUSHPLUS_TOKEN（如果使用）
# - ALERT_WECOM_WEBHOOK（监控告警）
# - GITHUB_TOKEN（已内置为 ${{ secrets.GITHUB_TOKEN }}）

# ============================================================
# 10. 云函数配置（部署到阿里云/腾讯云时使用）
# ============================================================

# 告警推送渠道（至少配置一个）
# ALERT_WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# ALERT_DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# ALERT_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# GitHub监控配置
# GITHUB_TOKEN=ghp_xxxxx
# GITHUB_REPO=owner/repo

# ============================================================
# 配置检查清单
# ============================================================
#
# 基础运行（必填）：
# ✅ OPENAI_API_KEY
# ✅ WECOM_WEBHOOK 或 FEISHU_WEBHOOK 或 PUSHPLUS_TOKEN（至少一个）
#
# 监控告警（推荐）：
# ✅ ALERT_WECOM_WEBHOOK 或其他告警渠道（至少一个）
# ✅ GITHUB_TOKEN（用于监控GitHub Actions）
#
# 完整功能（可选）：
# □ 微信公众号配置（WECHAT_APPID/SECRET）
# □ 备用LLM配置（ANTHROPIC_API_KEY/DASHSCOPE_API_KEY）
# □ 邮件告警配置
#
# ============================================================
